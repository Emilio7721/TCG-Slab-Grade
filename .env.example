# Copy this to .env and fill in your keys
# NEVER commit .env to version control

# Ximilar card identification & grading
EXPO_PUBLIC_XIMILAR_API_TOKEN=your_ximilar_token_here

# JustTCG pricing aggregator (free tier available)
EXPO_PUBLIC_JUSTTCG_API_KEY=your_justtcg_key_here

# eBay Browse API (free developer account)
EXPO_PUBLIC_EBAY_CLIENT_ID=your_ebay_client_id_here
EXPO_PUBLIC_EBAY_CLIENT_SECRET=your_ebay_client_secret_here

# PriceCharting (optional, for graded/sealed)
EXPO_PUBLIC_PRICECHARTING_API_KEY=your_pricecharting_key_here

# Supabase (optional, for cloud sync)
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Proxy backend URL (for production — keeps keys off device)
# EXPO_PUBLIC_PROXY_URL=https://your-proxy.railway.app
