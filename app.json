{
  "expo": {
    "name": "TCG Slab Grade",
    "slug": "tcg-slab-grade",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TCG Slab Grade to access your camera to scan cards."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TCG Slab Grade to access your photos to analyze cards."
        }
      ],
      "expo-sqlite"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tcgslabgrade.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.tcgslabgrade.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
